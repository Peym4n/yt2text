{
  "name": "yt2text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env ./bin/www.js",
    "watch": "nodemon --watch routes --watch views --watch public -e js,ejs,css --exec \"node --env-file-if-exists=.env\" ./bin/www.js"
  },
  "dependencies": {
    "connect-redis": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.19.0",
    "http-errors": "~2.0.1",
    "morgan": "^1.12.1",
    "redis": "^6.3.1",
    "youtube-caption-extractor": "^1.10.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.9"
    }
  }
}
